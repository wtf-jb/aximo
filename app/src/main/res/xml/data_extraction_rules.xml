<?xml version="1.0" encoding="utf-8"?>
<!-- Data stays on the device: no cloud backup. Device-to-device transfer is allowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <!-- API keys are bound to this device's Keystore and would be useless elsewhere. -->
    <device-transfer>
        <exclude domain="sharedpref" path="ai_keys.xml" />
    </device-transfer>
</data-extraction-rules>
