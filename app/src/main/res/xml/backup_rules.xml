<?xml version="1.0" encoding="utf-8"?>
<!-- Data stays on the device: no cloud backup (Android 11 and older). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
